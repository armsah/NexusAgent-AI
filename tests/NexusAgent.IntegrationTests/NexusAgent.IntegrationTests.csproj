<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NexusAgent.Api\NexusAgent.Api.csproj" />
    <ProjectReference Include="..\..\src\NexusAgent.Infrastructure\NexusAgent.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildCrashProbe" AfterTargets="Build">
    <MSBuild Projects="../NexusAgent.CrashProbe/NexusAgent.CrashProbe.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <CrashProbeFiles Include="../NexusAgent.CrashProbe/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CrashProbeFiles)"
          DestinationFiles="@(CrashProbeFiles->'$(OutDir)CrashProbe/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="BuildToolCrashProbe" AfterTargets="Build">
    <MSBuild Projects="../NexusAgent.ToolCrashProbe/NexusAgent.ToolCrashProbe.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <ToolCrashProbeFiles Include="../NexusAgent.ToolCrashProbe/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolCrashProbeFiles)"
          DestinationFiles="@(ToolCrashProbeFiles->'$(OutDir)ToolCrashProbe/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
